# Local development defaults. Copy to .env (never commit it) and set SECRET_KEY.
DEBUG=1
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
# Production, behind a TLS-terminating reverse proxy:
#DEBUG=0
#ALLOWED_HOSTS=inventory.example.com
#CSRF_TRUSTED_ORIGINS=https://inventory.example.com
#TRUST_PROXY=1
#FORWARDED_ALLOW_IPS=<proxy ip>,127.0.0.1   # read by gunicorn; see deploy/inventory.service
#DATA_DIR=/var/lib/inventory
# AI providers, tried in this order; leave a key empty to skip that provider.
FIREWORKS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_SEARCH_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
