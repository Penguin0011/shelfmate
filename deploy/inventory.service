[Unit]
Description=Household inventory backend
After=network.target

[Service]
User=inventory
Group=inventory
WorkingDirectory=/opt/inventory
EnvironmentFile=/etc/inventory.env
ExecStartPre=/opt/inventory/.venv/bin/python manage.py cleanup_drafts
ExecStart=/opt/inventory/.venv/bin/gunicorn config.wsgi:application --workers 1 --threads 4 --bind 0.0.0.0:8000 --timeout 75 --access-logfile -
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inventory

[Install]
WantedBy=multi-user.target
